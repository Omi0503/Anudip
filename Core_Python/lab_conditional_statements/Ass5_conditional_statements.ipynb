   "source": [
    "distance = float(input(\"Enter the distance traveled in km: \"))\n",
    "if distance <= 50:\n",
    "    fare = distance * 8\n",
    "elif distance <= 100:\n",
    "    fare = distance * 10\n",
    "else:\n",
    "    fare = distance * 12\n",
    "print(f\"The total fare for {distance} km is: Rs. {fare:.2f}\")"
   ]
