    "\n",
    "def rev_word(word):\n",
    "    return word[ : : -1]\n",
    "\n",
    "rev_word_str = ''\n",
    "\n",
    "for word in string.split():\n",
    "    rev_word_str += rev_word(word) + ' '\n",
