   "source": [
    "my_str = input('Enter a string in lowercase: ')\n",
    "\n",
    "rev_str = ''\n",
    "\n",
    "for char in my_str:\n",
    "    rev_str = char + rev_str\n",
    "\n",
    "if my_str == rev_str:\n",
    "    print(f'{my_str} is a palindrome string')\n",
    "else:\n",
    "    print(f'{my_str} is not a palindrome string')"
   ]
  },
