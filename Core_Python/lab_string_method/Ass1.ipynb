   "source": [
    "input_str = \"P@#yn26at^&i5ve\"\n",
    "alpha = 0\n",
    "digits = 0\n",
    "symbols = 0\n",
    "\n",
    "for char in input_str:\n",
    "    if char.isalpha():\n",
    "        alpha += 1\n",
    "    elif char.isdigit():\n",
    "        digits += 1\n",
    "    else:\n",
    "        symbols += 1\n",
    "\n",
    "print(f'Chars = {alpha} Digits = {digits} Symbol = {symbols}')"
   ]
